# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shiplog?schema=public"

# GitHub OAuth (NextAuth.js)
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# GitHub Webhook Verification
GITHUB_WEBHOOK_SECRET="whsec_your_github_webhook_secret"

# NextAuth.js Configuration
NEXTAUTH_SECRET="replace_with_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API (@google/genai)
GEMINI_API_KEY="your_google_gemini_api_key"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
